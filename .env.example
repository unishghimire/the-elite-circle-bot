DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_here
GEMINI_API_KEY=your_gemini_api_key_here

# Scheduler Configuration
# Timezone for daily posts (e.g. Asia/Kathmandu, America/New_York, UTC, etc.)
TIMEZONE=Asia/Kathmandu

# Daily Motivation Cron: Default 8:00 AM every day
MOTIVATION_CRON=0 8 * * *

# Meme Cron: Default Every 15 minutes
MEME_CRON=*/15 * * * *

# Book / Business & Social Skills Cron: Default 10:00 AM and 6:00 PM every day (2 times per day)
BOOK_CRON=0 10,18 * * *
